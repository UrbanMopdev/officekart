{
	# Railway terminates TLS at its edge; Caddy only serves plain HTTP inside.
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Fingerprinted build output never changes, so cache it hard.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else falls back to index.html so invite links like /r/ABC123 load the app.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
